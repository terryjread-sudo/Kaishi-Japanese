{
  "name": "kaishi-quest",
  "version": "11.25.30",
  "description": "Japanese vocabulary learner with visual mnemonics, speech, and games",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:manifest && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.js && vitest run",
    "test:e2e": "playwright test",
    "test:legacy": "node scripts/test.js",
    "generate:manifest": "node scripts/generate-content-manifest.mjs",
    "check:manifest": "node scripts/generate-content-manifest.mjs --check",
    "check": "npm run check:manifest && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "bump": "node scripts/bump.js"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
